{
  "manifest_version": 2,
  "core_api_major": 5,
  "package_version": "1.0.10",
  "id": "gp_rhythm_game",
  "name": "霓虹节拍",
  "kind": "minigame",
  "supported_systems": ["windows", "android"],
  "entry": "party_round.tscn",
  "introduction": "1–8 人同场演奏，各自选择难度，以最终准确率排名。",
  "player_counts": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "tags": [
    "original",
    "rhythm"
  ],
  "dependencies": {
    "godot_party_default_protocol": "1.0.8"
  },
  "adapters": [
    {
      "id": "standard",
      "protocol": {
        "id": "godot_party_default_protocol",
        "api_major": 1,
        "min_api_minor": 0
      },
      "entry": "adapter.gd"
    }
  ],
  "localization": {
    "supported_locales": [
      "zh_Hans"
    ],
    "fallback_locale": "zh_Hans",
    "translations": {
      "zh_Hans": "i18n/zh_Hans.po"
    }
  },
  "config_schema": "settings.gd",
  "cover": "assets/cover.png"
}
